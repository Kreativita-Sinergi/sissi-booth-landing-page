# Contoh variabel lingkungan fotobox-landing (tanpa rahasia).
# Lokal: salin ke .env.local (diabaikan git). Produksi: isi di Vercel › Settings › Environment Variables.
# Semua punya nilai bawaan di kode; yang WAJIB diisi di produksi hanya API_BASE_URL.

# Server API fotobox-service untuk dashboard /admin & /dashboard (src/lib/dash/api.ts).
# Bawaan: http://localhost:8090/api/v1 (server lokal).
API_BASE_URL=https://apibooth.sissi.id/api/v1

# Server file galeri; dipakai rewrite /s/:code/files/* (next.config.ts).
# Bawaan: https://apibooth.sissi.id
GALLERY_ORIGIN=https://apibooth.sissi.id

# Alamat situs untuk metadata & pratinjau tautan (src/app/layout.tsx).
# Bawaan: https://booth.sissi.id
NEXT_PUBLIC_SITE_URL=https://booth.sissi.id
